#!/usr/bin/env python3
"""Stand-in for `gh api` in the door's self-test: pull requests, check runs and merges from a state file. Logs `<METHOD> <path>` (no body, no
token) and the arguments; refuses without the expected token."""
import json
import os
import re
import sys

D = os.environ["STUB_DIR"]
a = sys.argv[1:]
with open(os.path.join(D, "gh-argv.log"), "a", encoding="utf-8") as fh:
    fh.write(" ".join(a) + "\n")
if a[:1] != ["api"] or os.environ.get("GH_TOKEN") != os.environ["STUB_GH"]:
    print("gh: Bad credentials (HTTP 401)", file=sys.stderr)
    sys.exit(1)
method, path, body = "GET", "", ""
i = 1
while i < len(a):
    if a[i] == "--method":
        method = a[i + 1]
        i += 2
    elif a[i] == "--input":
        body = sys.stdin.read()
        i += 2
    else:
        path = a[i]
        i += 1
with open(os.path.join(D, "gh-requests.log"), "a", encoding="utf-8") as fh:
    fh.write(f"{method} {path}\n")
with open(os.path.join(D, "gh-state.json"), encoding="utf-8") as fh:
    s = json.load(fh)
m = re.fullmatch(r"repos/Izzetee/homelab/pulls/(\d+)", path)
if method == "GET" and m:
    print(json.dumps(s["pulls"][m.group(1)]))
elif method == "GET" and re.fullmatch(r"repos/Izzetee/homelab/commits/[0-9a-f]{40}/check-runs", path):
    print(json.dumps({"check_runs": s["checks"].get(path.split("/")[4], [])}))
elif method == "POST" and path == "repos/Izzetee/homelab/pulls":
    with open(os.path.join(D, "gh-created.json"), "w", encoding="utf-8") as fh:
        fh.write(body)
    print(json.dumps({"number": 101}))
elif method == "PATCH" and m:
    with open(os.path.join(D, "gh-edited.json"), "w", encoding="utf-8") as fh:
        fh.write(body)
    print("{}")
elif method == "PUT" and re.fullmatch(r"repos/Izzetee/homelab/pulls/\d+/merge", path):
    with open(os.path.join(D, "gh-merged.json"), "w", encoding="utf-8") as fh:
        fh.write(body)
    print("{}")
else:
    print("gh: Not Found (HTTP 404)", file=sys.stderr)
    sys.exit(1)
