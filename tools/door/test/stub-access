#!/usr/bin/env python3
"""A tiny stand-in for the Cloudflare Access API: GET /accounts/<id>/access/apps answers the applications of the file given as the first argument.
Prints its port on the first line, refuses a wrong token with 403, answers 500 while the file `down` exists next to the state."""
import http.server
import json
import os
import sys

state = sys.argv[1]
want = os.environ["STUB_ACCESS"]


class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        if os.path.exists(state + ".down"):
            self.send_response(500)
            self.end_headers()
            return
        if self.headers.get("Authorization") != "Bearer " + want or "/access/apps" not in self.path:
            self.send_response(403)
            self.end_headers()
            return
        with open(state, encoding="utf-8") as fh:
            body = json.dumps({"success": True, "result": json.load(fh), "result_info": {"total_pages": 1}}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


srv = http.server.HTTPServer(("127.0.0.1", 0), H)
print(srv.server_address[1], flush=True)
srv.serve_forever()
