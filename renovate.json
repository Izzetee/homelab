{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-5 * * 6"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "updateNotScheduled": false,
  "automerge": false,
  "major": {
    "dependencyDashboardApproval": true
  },
  "platformCommit": "enabled",
  "kubernetes": {
    "managerFilePatterns": ["/^apps/.+\\.ya?ml$/", "/^networking/.+\\.ya?ml$/"]
  },
  "argocd": {
    "managerFilePatterns": ["/^apps/.+\\.ya?ml$/", "/^networking/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool images pinned as name:tag@sha256 in workflows and CI helpers",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/", "/^ci/.+\\.sh$/"],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[A-Za-z0-9_][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Git-sourced Ansible collections on GitHub (the ansible-galaxy manager cannot look them up)",
      "managerFilePatterns": ["/^ansible/requirements\\.ya?ml$/"],
      "matchStrings": [
        "name: https://github\\.com/(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_-]+)(?:\\.git)?\\s+type: git\\s+version: (?<currentValue>[A-Za-z0-9._-]+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "OpenTofu version pinned in required_version (the terraform manager would look up HashiCorp Terraform)",
      "managerFilePatterns": ["/^tofu/.+\\.tf$/"],
      "matchStrings": ["required_version\\s*=\\s*\"(?<currentValue>[0-9][0-9A-Za-z.-]*)\""],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Helm values that pin an image as repository, tag and digest on consecutive lines",
      "managerFilePatterns": ["/^apps/.+/values\\.ya?ml$/"],
      "matchStrings": [
        "repository: (?<depName>[a-z0-9][a-z0-9./_-]*)\\n\\s+tag: (?<currentValue>[A-Za-z0-9_][A-Za-z0-9._-]*)\\n\\s+digest: (?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Images of one registry path are not looked up",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/izzetee/lawnews/**"],
      "enabled": false
    },
    {
      "description": "Wait three days after a release before proposing a version update",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Dependencies handled by the custom managers above are not read by the stock managers",
      "matchManagers": ["ansible-galaxy"],
      "matchDatasources": ["github-tags"],
      "enabled": false
    },
    {
      "description": "required_version is OpenTofu, not HashiCorp Terraform",
      "matchManagers": ["terraform"],
      "matchDepNames": ["hashicorp/terraform"],
      "enabled": false
    },
    {
      "description": "n8n 3.x is an early-access release line; lift in its own change when n8n marks 3.x stable",
      "matchPackageNames": ["docker.io/n8nio/n8n"],
      "allowedVersions": "/^2\\./"
    },
    {
      "description": "n8n publishes each new minor as a beta and promotes it to stable with a later patch release: one branch per minor, and a minor waits for its approval on the dashboard; approve it once its newest release is n8n's stable tag (patches of the running minor need no approval)",
      "matchPackageNames": ["docker.io/n8nio/n8n"],
      "separateMultipleMinor": true,
      "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}.{{{newMinor}}}.x"
    },
    {
      "description": "n8n minors wait for the dashboard approval named in the rule above",
      "matchPackageNames": ["docker.io/n8nio/n8n"],
      "matchUpdateTypes": ["minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Runner labels stay: the pinned actionlint does not know ubuntu-26.04; lift with an actionlint that does",
      "matchDatasources": ["github-runners"],
      "enabled": false
    },
    {
      "description": "Authentik chart and image move together, one release line at a time (no skipping, no downgrade): the running line and the next one; the next line is merged only by its own upgrade change (dump, drill, checks); raise with each upgrade step",
      "matchDepNames": ["authentik", "ghcr.io/goauthentik/server"],
      "groupName": "authentik",
      "allowedVersions": "/^2026\\.(8|11)\\./"
    },
    {
      "description": "Read by the regex manager for repository/tag/digest pins (helm-values would write the digest into the tag)",
      "matchManagers": ["helm-values"],
      "matchDepNames": ["ghcr.io/goauthentik/server"],
      "enabled": false
    },
    {
      "description": "Dummy image of a CI self-test, not a dependency",
      "matchPackageNames": ["example.test/**"],
      "enabled": false
    },
    {
      "description": "Guardrail files are never merged automatically",
      "matchFileNames": [".github/**", "ci/**", ".gitleaks.toml", "renovate.json"],
      "automerge": false,
      "addLabels": ["needs-user"]
    },
    {
      "description": "Ansible collections and OpenTofu providers are never merged automatically",
      "matchManagers": ["ansible-galaxy", "terraform"],
      "automerge": false,
      "addLabels": ["needs-user"]
    },
    {
      "description": "The custom regex managers read the k3s-ansible collection and the OpenTofu version: same rule",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["k3s-io/k3s-ansible", "opentofu/opentofu"],
      "automerge": false,
      "addLabels": ["needs-user"]
    }
  ]
}
